pipeline {
    agent any

    tools {
        nodejs 'node22'
    }

    environment {
        SCANNER_HOME = tool 'sonar-scanner'
    }

    stages {

        stage('Git Checkout') {
            steps {
                git branch: 'master', credentialsId: 'github-cred', url: 'https://github.com/awais684/3-tier-devops-project.git'
            }
        }

        stage('Install Package Dependencies') {
            steps {
                sh "npm install"
            }
        }

        stage('Unit Tests') {
            steps {
                sh "npm test"
            }
        }

        stage('Trivy FS Scan') {
            steps {
                sh "trivy fs --format table -o trivy-report.html ."
                archiveArtifacts artifacts: 'trivy-report.html', fingerprint: true
            }
        }

        stage('SonarQube') {
            steps {
                withSonarQubeEnv('sonar') {
                    sh "$SCANNER_HOME/bin/sonar-scanner -Dsonar.projectKey=Campground -Dsonar.projectName=Campground"
                }
            }
        }

        stage('Docker Login') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'docker-cred', usernameVariable: 'USER', passwordVariable: 'PASS')]) {
                    sh 'echo $PASS | docker login -u $USER --password-stdin'
                }
            }
        }

        stage('Docker Build & Tag') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker-cred', toolName: 'docker') {
                        sh "docker build -t awais684/camp:latest ."
                    }
                }
            }
        }

        stage('Trivy Image Scan') {
            steps {
                sh "trivy image --format table -o trivy-image-report.html awais684/camp:latest"
                archiveArtifacts artifacts: 'trivy-image-report.html', fingerprint: true
            }
        }

        stage('Docker Push Image') {
            steps {
                script {
                    withDockerRegistry(credentialsId: 'docker-cred', toolName: 'docker') {
                        sh "docker push awais684/camp:latest"
                    }
                }
            }
        }

        stage('Deploy To K8s') {
            steps {
                script {
                    withKubeCredentials(kubectlCredentials: [[caCertificate: '', clusterName: 'my-eks22', contextName: '', credentialsId: 'k8s-token', namespace: 'webapps', serverUrl: 'https://3D4FE6EBD91A083FDB207AF1002B474F.gr7.us-east-1.eks.amazonaws.com']]) {
                        sh "kubectl apply -f Manifests/dss.yml"
                        sleep 60
                    }
                }
            }
        }
    }

    post {

        success {
            mail(
                to: 'awaiszahid684@gmail.com',
                subject: "✅ Dev Pipeline Passed — Ready for Prod Deploy #${env.BUILD_NUMBER}",
                body: """\
Hi Prod Team,

Good news! The Dev pipeline has completed successfully and the image is ready to deploy.

Build Details:
──────────────────────────────
Job Name     : ${env.JOB_NAME}
Build Number : #${env.BUILD_NUMBER}
Branch       : ${env.GIT_BRANCH}
Build URL    : ${env.BUILD_URL}

Docker Image:
──────────────────────────────
awais684/camp:latest is pushed to Docker Hub and ready for production.

Regards,
Jenkins Automation
                """.stripIndent()
            )
        }

        failure {
            mail(
                to: 'awaiszahid684@gmail.com',
                subject: "❌ Dev Pipeline FAILED — Build #${env.BUILD_NUMBER}",
                body: """\
Hi Dev Team,

The Dev pipeline has FAILED. Please investigate and fix before prod deployment.

Build Details:
──────────────────────────────
Job Name     : ${env.JOB_NAME}
Build Number : #${env.BUILD_NUMBER}
Branch       : ${env.GIT_BRANCH}
Build URL    : ${env.BUILD_URL}

What To Do:
──────────────────────────────
1. Click Build URL above to see which stage failed
2. Fix the issue on dev branch
3. Push the fix and pipeline will re-trigger

Regards,
Jenkins Automation
                """.stripIndent()
            )
        }

    }

}
